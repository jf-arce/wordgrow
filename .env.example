# Connection strings de Neon (https://neon.tech). Copiá este archivo a .env y completá.
# Pooled: la usa la app en runtime (lib/db/index.ts).
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/wordgrow?sslmode=require"
# Directa (sin pooler): la usan las migraciones de Prisma (prisma.config.ts).
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/wordgrow?sslmode=require"
